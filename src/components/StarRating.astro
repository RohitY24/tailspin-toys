---
import { clampRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full whitespace-nowrap" data-testid="game-star-rating">
        {clampRating(rating).toFixed(1)} out of 5
    </span>
)}

{rating === null && (
    <span class="bg-slate-700/50 text-slate-300 text-sm px-3 py-1 rounded-full whitespace-nowrap" data-testid="game-no-rating">
        No rating yet
    </span>
)}
